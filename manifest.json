{
  "id": "com.fern.ticktick-sync",
  "name": "TickTick Sync",
  "version": "0.1.1",
  "api_version": 1,
  "min_fern_version": "0.2.0",
  "description": "Two-way sync of lists and tasks with TickTick (OAuth 2.0).",
  "author": "atabits",
  "homepage": "https://github.com/atabits/fern-ticktick-sync",
  "entry": "index.js",
  "permissions": [
    "tasks:read",
    "tasks:write",
    "lists:read",
    "lists:write",
    "storage",
    "clipboard",
    { "network": ["api.ticktick.com", "ticktick.com"] }
  ],
  "activation_events": [
    "onStartup",
    "onView:sync",
    "onCommand:sync_now",
    "onCommand:connect",
    "onEvent:task.created",
    "onEvent:task.updated",
    "onEvent:task.completed",
    "onEvent:task.reopened",
    "onEvent:task.deleted"
  ],
  "contributions": {
    "pages": [
      {
        "id": "sync",
        "title": "TickTick",
        "icon": "icons/ticktick.svg"
      }
    ],
    "commands": [
      {
        "id": "sync_now",
        "title": "TickTick: Sync Now"
      },
      {
        "id": "connect",
        "title": "TickTick: Sign In"
      }
    ]
  },
  "settings": [
    {
      "key": "client_id",
      "type": "text",
      "label": "Client ID",
      "placeholder": "Paste from developer.ticktick.com/manage",
      "default": ""
    },
    {
      "key": "client_secret",
      "type": "secret",
      "label": "Client Secret"
    },
    {
      "key": "sync_direction",
      "type": "select",
      "label": "Sync Mode",
      "options": [
        { "label": "Two-way (Recommended)", "value": "two_way" },
        { "label": "TickTick → Fern only", "value": "pull_only" },
        { "label": "Fern → TickTick only", "value": "push_only" }
      ],
      "default": "two_way"
    },
    {
      "key": "sync_interval_min",
      "type": "select",
      "label": "Auto-Sync",
      "options": [
        { "label": "Every 5 minutes", "value": "5" },
        { "label": "Every 2 minutes", "value": "2" },
        { "label": "Every 15 minutes", "value": "15" },
        { "label": "Manual only", "value": "0" }
      ],
      "default": "5"
    },
    {
      "key": "conflict_policy",
      "type": "select",
      "label": "Conflict Policy",
      "options": [
        { "label": "Last-Write-Wins (Recommended)", "value": "lww" },
        { "label": "Fern wins", "value": "fern_wins" },
        { "label": "TickTick wins", "value": "ticktick_wins" }
      ],
      "default": "lww"
    },
    {
      "key": "delete_policy",
      "type": "select",
      "label": "When Deleted in TickTick",
      "options": [
        { "label": "Move to Trash in Fern", "value": "trash" },
        { "label": "Unlink only (keep in Fern)", "value": "unlink" }
      ],
      "default": "trash"
    }
  ]
}
